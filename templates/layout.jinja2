<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <title>
        {% block title %}
        The Daily Feed
        {% endblock %}
    </title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link
        rel="stylesheet"
        href="{{ url_for('static', filename='css/newspaper.css') }}">
</head>

<body>

<div class="newspaper">

    <header class="masthead">

        <div class="edition">
            Independent News Aggregator
        </div>

        <h1>THE DAILY FEED</h1>

        <div class="masthead-divider"></div>

        <nav class="navbar">
            <a href="/">News</a>
            <a href="/publishers">Publishers</a>
            <a href="/refresh">Refresh</a>
        </nav>

    </header>

    <main>

        {% block content %}
        {% endblock %}

    </main>

</div>

</body>

</html>